<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <IsPackable>true</IsPackable>
    <Title>Kiji site template</Title>
    <Description>The `dotnet new kiji` project template for Kiji, a static site generator framework for .NET. Scaffolds a Razor-component site with a markdown blog, RSS feed, and sitemap.</Description>
    <PackageTags>dotnet-new;templates;template;static-site-generator;ssg;razor;blazor;markdown</PackageTags>

    <!-- Content-only package: nothing here is compiled, and no assembly ships. -->
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The template's own .cs/.razor files are content, never compile inputs. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- .template.config/ and the template's .gitignore are dot-paths, which NuGet
         excludes by default. Keeping them means excluding build output explicitly. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- NU5128: dependency groups without lib/ref assemblies. SuppressDependenciesWhenPacking
         should remove them already; TreatWarningsAsErrors leaves no room for surprises. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="site/**"
             Exclude="site/KijiSite.csproj;site/**/bin/**;site/**/obj/**;site/**/dist/**;site/**/.kiji/**"
             PackagePath="content/site/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Staged copy with the Kiji version substituted; see StageSiteProject below. -->
    <Content Include="$(IntermediateOutputPath)template/KijiSite.csproj"
             PackagePath="content/site/KijiSite.csproj" />
    <Compile Remove="**/*" />
    <EmbeddedResource Remove="**/*" />
  </ItemGroup>

  <!-- A scaffolded site must reference exactly the Kiji version shipped alongside this
       template. MinVer supplies $(Version); the edit lands on a staged copy so the file
       on disk stays a valid, loadable project. XmlPoke rather than text replacement,
       because csproj content contains ';' and would be split by item semantics. -->
  <Target Name="StageSiteProject"
          DependsOnTargets="MinVer"
          BeforeTargets="PrepareForBuild;_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <_SiteProjectSource>$(MSBuildProjectDirectory)/site/KijiSite.csproj</_SiteProjectSource>
      <_SiteProjectStaged>$(IntermediateOutputPath)template/KijiSite.csproj</_SiteProjectStaged>
    </PropertyGroup>
    <Copy SourceFiles="$(_SiteProjectSource)" DestinationFiles="$(_SiteProjectStaged)" />
    <XmlPoke XmlInputPath="$(_SiteProjectStaged)"
             Query="/Project/ItemGroup/PackageReference[@Include='Kiji']/@Version"
             Value="$(Version)" />
  </Target>

</Project>

@page "/docs/"
@inject SiteInfo Site
@inject ContentDictionary<MarkdownContent<DocFrontMatter>> Docs

<PageHead Title="Documentation" Description="Guides for building a site with Kiji." />

<h1>Documentation</h1>

<ul class="doc-list">
    @foreach (var (slug, doc) in Docs.OrderBy(entry => entry.Value.FrontMatter.Order))
    {
        <li>
            <a href="@Site.Path($"docs/{slug}/")">
                @doc.FrontMatter.Title
            </a>
            <p>@doc.FrontMatter.Description</p>
        </li>
    }
</ul>

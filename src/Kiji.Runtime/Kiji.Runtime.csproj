<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Kiji.Runtime.$(KijiRuntimeIdentifier)</PackageId>
    <Description>Precompiled code of Kiji for $(KijiRuntimeIdentifier). Restored with Kiji for a site that builds for this runtime; not referenced directly.</Description>
    <PackageTags>kiji</PackageTags>
    <PackageLicenseExpression>MIT AND BSD-2-Clause</PackageLicenseExpression>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <MinVerSkip>true</MinVerSkip>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(KijiRuntimeContent)' != ''">
    <None Include="$(KijiRuntimeContent)kiji-r2r/**" Pack="true" PackagePath="runtimes/$(KijiRuntimeIdentifier)/native/kiji-r2r/" />
    <None Include="$(KijiThirdPartyNotices)" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

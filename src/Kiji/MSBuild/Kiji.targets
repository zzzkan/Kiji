<Project>
  <PropertyGroup>
    <!-- Test projects advertise themselves through different SDK properties; only inner builds can run. -->
    <_KijiIsSiteApp Condition="'$(OutputType)' == 'Exe' and
                               '$(IsTestProject)' != 'true' and '$(TestProject)' != 'true' and
                               '$(IsTestingPlatformApplication)' != 'true' and
                               ('$(TargetFrameworks)' == '' or '$(TargetFramework)' != '')">true</_KijiIsSiteApp>
  </PropertyGroup>

  <!-- Stable Release site MVIDs allow cache reuse across checkouts. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(_KijiIsSiteApp)' == 'true'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <UseAppHost>false</UseAppHost>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap Condition="'$(PathMap)' != ''">$(PathMap),</PathMap>
    <PathMap>$(PathMap)$(MSBuildProjectDirectory)=/_/source</PathMap>
    <!-- NuGet imports may follow the SDK PDB output calculation; honor global DebugType. -->
    <_DebugSymbolsProduced Condition="'$(DebugType)' == 'none'">false</_DebugSymbolsProduced>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(_KijiIsSiteApp)' == 'true' and '$(DebugType)' == 'none'">
    <_DebugSymbolsIntermediatePath Remove="@(_DebugSymbolsIntermediatePath)" />
    <_DebugSymbolsOutputPath Remove="@(_DebugSymbolsOutputPath)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(_KijiIsSiteApp)' == 'true'">
    <_KijiDotNetHost>$(DOTNET_HOST_PATH)</_KijiDotNetHost>
    <_KijiDotNetHost Condition="'$(_KijiDotNetHost)' == ''">dotnet</_KijiDotNetHost>
    <StaticWebAssetsEnabled Condition="'$(StaticWebAssetsEnabled)' == ''">true</StaticWebAssetsEnabled>
    <!-- Compression is opt-in. Kiji compresses the site itself, so the SDK's formats stay empty. -->
    <CompressionEnabled Condition="'$(CompressionEnabled)' == ''">false</CompressionEnabled>
    <EnableDefaultCompressionFormats Condition="'$(EnableDefaultCompressionFormats)' == ''">false</EnableDefaultCompressionFormats>
    <_KijiConfiguredStaticWebAssetBasePath>$(StaticWebAssetBasePath)</_KijiConfiguredStaticWebAssetBasePath>
    <!-- The site uses root paths; libraries retain their configured paths. -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <CustomAfterStaticWebAssetsSdkTargets>$(MSBuildThisFileDirectory)Kiji.StaticWebAssets.targets</CustomAfterStaticWebAssetsSdkTargets>
  </PropertyGroup>

  <!-- Runtime metadata keeps checkout paths out of code identity. -->
  <ItemGroup Condition="'$(_KijiIsSiteApp)' == 'true'">
    <RuntimeHostConfigurationOption Include="Kiji.ProjectDirectory" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>

  <!-- dotnet watch reports compilation errors, which the dev server shows, only to ASP.NET Core
       projects. The Web SDK declares this capability; Razor SDK sites get it only while watching. -->
  <ItemGroup Condition="'$(_KijiIsSiteApp)' == 'true' and '$(DotNetWatchBuild)' == 'true'">
    <ProjectCapability Include="AspNetCore" />
  </ItemGroup>

  <Target Name="KijiValidateAssetSdk" BeforeTargets="PrepareForBuild;KijiGenerateSite"
          Condition="'$(_KijiIsSiteApp)' == 'true'">
    <Error Condition="'$(UsingMicrosoftNETSdkRazor)' != 'true'" Code="KIJI1003"
           Text="Kiji sites require Microsoft.NET.Sdk.Razor (or Microsoft.NET.Sdk.Web) to resolve CSS isolation and static web assets." />
    <Error Condition="'$(StaticWebAssetsEnabled)' != 'true'" Code="KIJI1003"
           Text="Kiji sites require StaticWebAssetsEnabled=true." />
    <Error Condition="'$(_KijiConfiguredStaticWebAssetBasePath)' != '' and '$(_KijiConfiguredStaticWebAssetBasePath)' != '/'"
           Code="KIJI1004" Text="Set SiteInfo.BaseUrl to host a Kiji site under a path prefix. StaticWebAssetBasePath is supported on libraries, not on the site project." />
  </Target>

  <Target Name="KijiGenerateSite"
          Condition="'$(_KijiIsSiteApp)' == 'true' and '$(DesignTimeBuild)' != 'true'" Returns="@(KijiSiteFile)">
    <!-- Resolve after the SDK finalizes IntermediateOutputPath. Staging stays stable across publish destinations. -->
    <PropertyGroup>
      <_KijiDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'kiji'))</_KijiDir>
      <_KijiStagingDir>$(_KijiDir)site$([System.IO.Path]::DirectorySeparatorChar)</_KijiStagingDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(TargetPath)')" Code="KIJI1001"
           Text="Kiji cannot generate the site: '$(TargetPath)' does not exist. Build the project before publishing." />

    <!-- Keep publish context out of the normal runtimeconfig and inherited environment. -->
    <ItemGroup>
      <_KijiHostConfigurationOption Include="@(RuntimeHostConfigurationOption)" />
      <_KijiHostConfigurationOption Include="Kiji.OutputPath" Value="$(_KijiStagingDir)" />
    </ItemGroup>
    <MakeDir Directories="$(_KijiDir)" />
    <!-- Keep these arguments aligned with the SDK's GenerateBuildRuntimeConfigurationFiles
         target. Publish uses its own config path and host options, with no dev companion. -->
    <GenerateRuntimeConfigurationFiles AssetsFilePath="$(ProjectAssetsFile)"
                                       TargetFramework="$(TargetFramework)"
                                       TargetFrameworkMoniker="$(TargetFrameworkMoniker)"
                                       RuntimeConfigPath="$(_KijiDir)publish.runtimeconfig.json"
                                       RuntimeIdentifier="$(RuntimeIdentifier)"
                                       PlatformLibraryName="$(MicrosoftNETPlatformLibrary)"
                                       RuntimeFrameworks="@(RuntimeFramework)"
                                       RollForward="$(RollForward)"
                                       UserRuntimeConfig="$(UserRuntimeConfig)"
                                       HostConfigurationOptions="@(_KijiHostConfigurationOption)"
                                       AdditionalProbingPaths="@(AdditionalProbingPath)"
                                       IsSelfContained="$(SelfContained)"
                                       WriteIncludedFrameworks="$(_WriteIncludedFrameworks)"
                                       GenerateRuntimeConfigDevFile="false"
                                       AlwaysIncludeCoreFramework="$(AlwaysIncludeCoreFrameworkInRuntimeConfig)" />

    <!-- Only the process exit code fails publish; log lines remain MSBuild messages. -->
    <Exec Command="&quot;$(_KijiDotNetHost)&quot; exec --runtimeconfig &quot;$(_KijiDir)publish.runtimeconfig.json&quot; &quot;$(TargetPath)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="high" StandardErrorImportance="high" />

    <ItemGroup>
      <KijiSiteFile Include="$(_KijiStagingDir)**\*" />
      <KijiSiteFile RelativePath="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <Error Condition="'@(KijiSiteFile)' == ''" Code="KIJI1002"
           Text="Kiji generated no files into '$(_KijiStagingDir)'. The site exited successfully without writing anything — check that its entry point awaits StaticSite.RunAsync." />
  </Target>

  <Target Name="KijiGenerateServiceWorker" Condition="'$(ServiceWorkerAssetsManifest)' != ''">
    <PropertyGroup>
      <_KijiWorkerDir>$(_KijiDir)service-worker$([System.IO.Path]::DirectorySeparatorChar)</_KijiWorkerDir>
      <_KijiParentPath>..$([System.IO.Path]::DirectorySeparatorChar)</_KijiParentPath>
      <_KijiWorkerSource>@(ServiceWorker->'%(FullPath)')</_KijiWorkerSource>
      <_KijiWorkerPublishedSource>@(ServiceWorker->'%(PublishedContent)')</_KijiWorkerPublishedSource>
      <!-- Publish where the SDK does: at the worker's path under wwwroot, otherwise under the project. -->
      <_KijiWorkerPath></_KijiWorkerPath>
      <_KijiWorkerPath Condition="'$(_KijiWorkerSource)' != ''">$([MSBuild]::MakeRelative($([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'wwwroot')), '$(_KijiWorkerSource)'))</_KijiWorkerPath>
      <_KijiWorkerPath Condition="$(_KijiWorkerPath.StartsWith('$(_KijiParentPath)'))">$([MSBuild]::MakeRelative($([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)')), '$(_KijiWorkerSource)'))</_KijiWorkerPath>
    </PropertyGroup>
    <!-- A path outside the project would publish outside the publish directory, possibly over a source file. -->
    <Error Condition="'$(_KijiWorkerPath)' != '' and ($(_KijiWorkerPath.StartsWith('$(_KijiParentPath)')) or $([System.IO.Path]::IsPathRooted('$(_KijiWorkerPath)')))"
           Code="KIJI1006" Text="ServiceWorker '$(_KijiWorkerSource)' is outside the project directory. Move it into the project, normally under wwwroot." />
    <Error Condition="'$(_KijiWorkerPath)' != '' and '$(_KijiWorkerPublishedSource)' == ''" Code="KIJI1006"
           Text="ServiceWorker '$(_KijiWorkerSource)' has no PublishedContent. Set it to the worker to publish, such as wwwroot/service-worker.published.js." />
    <GetFileHash Files="@(KijiSiteFile)" Algorithm="SHA256" HashEncoding="base64" MetadataName="Integrity">
      <Output TaskParameter="Items" ItemName="_KijiWorkerAsset" />
    </GetFileHash>
    <ItemGroup>
      <_KijiWorkerAsset AssetUrl="$([System.String]::Copy('%(RelativePath)').Replace('\', '/'))" />
      <KijiSiteFile Include="$(_KijiWorkerDir)$(ServiceWorkerAssetsManifest)" RelativePath="$(ServiceWorkerAssetsManifest)" />
      <KijiSiteFile Include="$(_KijiWorkerDir)$(_KijiWorkerPath)" RelativePath="$(_KijiWorkerPath)" Condition="'$(_KijiWorkerPath)' != ''" />
    </ItemGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_KijiWorkerDir)$(ServiceWorkerAssetsManifest)'));$([System.IO.Path]::GetDirectoryName('$(_KijiWorkerDir)$(_KijiWorkerPath)'))" />

    <GenerateServiceWorkerAssetsManifest Version="$(ServiceWorkerAssetsManifestVersion)" Assets="@(_KijiWorkerAsset)"
                                         OutputPath="$(_KijiWorkerDir)$(ServiceWorkerAssetsManifest)">
      <Output TaskParameter="CalculatedVersion" PropertyName="_KijiWorkerVersion" />
    </GenerateServiceWorkerAssetsManifest>
    <UpdateServiceWorkerFileWithVersion Condition="'$(_KijiWorkerPath)' != ''"
                                        ServiceWorkerSource="$(_KijiWorkerPublishedSource)"
                                        ServiceWorkerDestination="$(_KijiWorkerDir)$(_KijiWorkerPath)"
                                        ManifestVersion="$(_KijiWorkerVersion)" />
  </Target>

  <Target Name="KijiCompressSite" Condition="'$(CompressionEnabled)' == 'true'">
    <ItemGroup>
      <_KijiCompressible Include="@(KijiSiteFile)"
                         Condition="'%(Extension)' == '.html' or '%(Extension)' == '.css' or '%(Extension)' == '.js' or
                                    '%(Extension)' == '.mjs' or '%(Extension)' == '.json' or '%(Extension)' == '.xml' or
                                    '%(Extension)' == '.svg' or '%(Extension)' == '.txt'" />
      <_KijiCompressible RelatedAsset="%(FullPath)" />
      <_KijiGzipFile Include="@(_KijiCompressible->'$(_KijiDir)compressed\%(RelativePath).gz')" />
      <_KijiGzipFile RelativePath="%(RelativePath).gz" />
      <_KijiBrotliFile Include="@(_KijiCompressible->'$(_KijiDir)compressed\%(RelativePath).br')" />
      <_KijiBrotliFile RelativePath="%(RelativePath).br" />
    </ItemGroup>
    <GZipCompress Condition="'@(_KijiGzipFile)' != ''" FilesToCompress="@(_KijiGzipFile)" />
    <BrotliCompress Condition="'@(_KijiBrotliFile)' != ''" FilesToCompress="@(_KijiBrotliFile)"
                    CompressionLevel="$(BrotliCompressionLevel)" ToolAssembly="$(_StaticWebAssetsSdkToolAssembly)"
                    ToolExe="$(_DotNetHostFileName)" ToolPath="$(_DotNetHostDirectory)" />
  </Target>

  <Target Name="KijiComputeFilesToPublish" AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="KijiGenerateSite;KijiGenerateServiceWorker;KijiCompressSite"
          Condition="'$(_KijiIsSiteApp)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <!-- Replace the SDK application list before incremental copy and cleanup. -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" />
      <!-- Always copies when size or time differs (SkipCopyUnchangedFiles), so an older source from another
           configuration still replaces a newer copy. SDK 10.0.1xx silently drops IfDifferent items. -->
      <ResolvedFileToPublish Include="@(KijiSiteFile);@(_KijiGzipFile);@(_KijiBrotliFile)" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>

  <Target Name="KijiClean" AfterTargets="Clean" Condition="'$(_KijiIsSiteApp)' == 'true'">
    <!-- The staged site is not tracked in FileWrites, and the assembly is gone after Clean. -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)/.kiji;$(IntermediateOutputPath)kiji" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>

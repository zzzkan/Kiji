<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Kiji</PackageId>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0</PackageValidationBaselineVersion>
    <Description>A static site generator for .NET. Use Razor components to build pages, with Markdown, layouts, and static assets.</Description>
    <PackageTags>static-site-generator;ssg;razor;blazor;markdown</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <!-- Only the published validation baseline uses Hashing. Do not ship it to consumers. -->
    <PackageReference Include="System.IO.Hashing" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hosting/livereload.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- build/, not buildTransitive/: these targets turn a project's publish output into a
         generated site, which is only ever right for a project that references Kiji directly.
         buildTransitive would also reach whatever references that project — a site's own test
         project first of all. The file name has to match the package id. -->
    <None Update="MSBuild/Kiji.targets" Pack="true" PackagePath="build/Kiji.targets" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Kiji.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Kiji.Benchmarks</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Kiji.SyntheticSite</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

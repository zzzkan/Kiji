<Project>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Kiji.Analyzers' and '$(MSBuildProjectName)' != 'Kiji.Runtime'">
    <AdditionalFiles Include="$(MSBuildProjectFullPath);**/*.props;**/*.targets;**/*.css;**/*.js;**/*.mjs;**/*.cs"
                     Exclude="@(Compile);@(AdditionalFiles);bin/**;obj/**;dist/**;.kiji/**" />
    <AdditionalFiles Include="**/*.razor;**/*.csproj" Exclude="@(AdditionalFiles);bin/**;obj/**;dist/**;.kiji/**"
                     Condition="'$(UsingMicrosoftNETSdkRazor)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Kiji'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)Directory.Build.props;$(MSBuildThisFileDirectory)Directory.Build.targets;$(MSBuildThisFileDirectory)Directory.Packages.props" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory).editorconfig;$(MSBuildThisFileDirectory).gitignore" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory).github/**/*.yml" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory).agents/**/*.ps1;$(MSBuildThisFileDirectory).agents/**/*.sh;$(MSBuildThisFileDirectory).agents/**/*.py;$(MSBuildThisFileDirectory).agents/**/*.mjs;$(MSBuildThisFileDirectory).agents/**/*.cs" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src/Kiji.Analyzers/**/*.cs;$(MSBuildThisFileDirectory)src/Kiji.Analyzers/*.csproj;$(MSBuildThisFileDirectory)src/Kiji.Runtime/*.csproj"
                     Exclude="$(MSBuildThisFileDirectory)src/Kiji.Analyzers/obj/**;$(MSBuildThisFileDirectory)src/Kiji.Analyzers/bin/**" />
  </ItemGroup>

  <Target Name="KijiRequireHandWrittenComponents" BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'Kiji' or '$(MSBuildProjectName)' == 'Kiji.Tests'">
    <ItemGroup>
      <_KijiRazorFile Include="$(MSBuildProjectDirectory)/**/*.razor;$(MSBuildProjectDirectory)/**/*.cshtml"
                      Exclude="$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**" />
    </ItemGroup>
    <Error Condition="'$(UsingMicrosoftNETSdkRazor)' == 'true'"
           Code="KR0002"
           Text="$(MSBuildProjectName) builds with Microsoft.NET.Sdk, not the Razor SDK. Write components as ComponentBase classes that override BuildRenderTree, as in src/Kiji/Components." />
    <Error Condition="'@(_KijiRazorFile)' != ''"
           Code="KR0002"
           File="%(_KijiRazorFile.Identity)"
           Text="$(MSBuildProjectName) does not use Razor files. Rewrite %(_KijiRazorFile.Filename)%(_KijiRazorFile.Extension) as a ComponentBase class that overrides BuildRenderTree, as in src/Kiji/Components." />
  </Target>

  <PropertyGroup>
    <KijiAllowedProjectReferences Condition="'$(MSBuildProjectName)' == 'Kiji.Tests'">Kiji</KijiAllowedProjectReferences>
    <KijiAllowedProjectReferences Condition="'$(MSBuildProjectName)' == 'Kiji.SyntheticSite'">Kiji</KijiAllowedProjectReferences>
    <KijiAllowedProjectReferences Condition="'$(MSBuildProjectName)' == 'Kiji.Docs'">Kiji</KijiAllowedProjectReferences>
    <KijiAllowedProjectReferences Condition="'$(MSBuildProjectName)' == 'Kiji.Benchmarks'">Kiji;Kiji.SyntheticSite</KijiAllowedProjectReferences>
    <KijiAllowedProjectReferences Condition="'$(MSBuildProjectName)' == 'Kiji.PackageTests'">Kiji</KijiAllowedProjectReferences>
  </PropertyGroup>

  <Target Name="KijiCheckProjectReferences" BeforeTargets="ResolveProjectReferences">
    <ItemGroup>
      <_KijiProjectReference Include="@(ProjectReference->'%(Filename)')" Condition="'%(ProjectReference.OutputItemType)' != 'Analyzer'" />
      <_KijiAllowedProjectReference Include="$(KijiAllowedProjectReferences)" />
      <_KijiForbiddenProjectReference Include="@(_KijiProjectReference)" Exclude="@(_KijiAllowedProjectReference)" />
      <_KijiPackageTestsCompileReference Include="@(ProjectReference)"
                                         Condition="'$(MSBuildProjectName)' == 'Kiji.PackageTests' and '%(ProjectReference.OutputItemType)' != 'Analyzer' and '%(ProjectReference.ReferenceOutputAssembly)' != 'false'" />
    </ItemGroup>
    <Error Condition="'@(_KijiForbiddenProjectReference)' != ''"
           Code="KR0003"
           Text="$(MSBuildProjectName) may not reference @(_KijiForbiddenProjectReference). Allowed: '$(KijiAllowedProjectReferences)'. Remove the reference, or change the project graph in Directory.Build.targets as a reviewed design change." />
    <Error Condition="'@(_KijiPackageTestsCompileReference)' != ''"
           Code="KR0003"
           Text="Kiji.PackageTests tests the packed package as a black box. Keep ReferenceOutputAssembly=&quot;false&quot; on its reference to @(_KijiPackageTestsCompileReference->'%(Filename)'); it only orders the build." />
  </Target>

</Project>

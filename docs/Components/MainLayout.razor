@inherits LayoutComponentBase
@inject SiteInfo Site
@inject ContentDictionary<Article> Docs

<a class="skip-link" href="#main-content">Skip to content</a>

<header class="site-header">
    <div class="bar">
        <a class="site-title" href="@Site.BaseUrl.AbsolutePath">@($"📰 {Site.Name}")</a>
        <nav aria-label="Main">
            <a href="https://github.com/zzzkan/kiji">GitHub</a>
            <a href="https://www.nuget.org/packages/Kiji">NuGet</a>
        </nav>
    </div>
</header>

<div class="shell">
    <nav class="side-nav" aria-label="Documentation">
        <p class="side-nav-title">Documentation</p>
        <ul>
            @foreach (var doc in Docs.Values.OrderBy(doc => doc.Order))
            {
                <li>
                    <a href="@(Site.BaseUrl.AbsolutePath + $"docs/{doc.Slug}/")">
                        @doc.Title
                    </a>
                </li>
            }
        </ul>
    </nav>

    <main id="main-content">@Body</main>
</div>

<footer class="site-footer">
    <p>
        © 2026 zzzkan, built with
        <a href="https://github.com/zzzkan/kiji/tree/main/docs">Kiji</a>.
    </p>
</footer>

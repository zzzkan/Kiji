<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);content/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Kiji" Version="$(KijiPackageVersion)" />
    <ProjectReference Include="../Library/Library.csproj" />
    <ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="service-worker.published.js" />
  </ItemGroup>
</Project>

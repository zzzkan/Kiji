{
  "$schema": "https://json.schemastore.org/template",
  "author": "zzzkan",
  "classifications": [ "Web", "Static Site Generator", "Razor", "Blazor" ],
  "identity": "Kiji.Site.CSharp",
  "name": "Kiji static site",
  "description": "A Kiji static site: Razor component pages, a markdown blog, an RSS feed, and a sitemap.",
  "shortName": "kiji",
  "sourceName": "KijiSite",
  "defaultName": "KijiSite",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [ "bin/**", "obj/**", "dist/**", ".kiji/**", "**/*.user" ]
        }
      ]
    }
  ],
  "symbols": {
    "siteName": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "SITE_NAME",
      "defaultValue": "My Kiji Site",
      "description": "The site name, used in page titles, the RSS feed, and sitemap metadata."
    },
    "baseUrl": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "SITE_BASE_URL",
      "defaultValue": "https://example.com/",
      "description": "The published base URL. Include a path segment for a project site, e.g. https://your-name.github.io/my-site/."
    }
  },
  "primaryOutputs": [
    { "path": "KijiSite.csproj" }
  ]
}

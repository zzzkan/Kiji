<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <NoWarn>$(NoWarn);CA1707;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../Kiji/Kiji.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" PrivateAssets="all" />
    <Compile Remove="Fixture/**/*.cs" />
    <EmbeddedResource Remove="Fixture/**/*" />
  </ItemGroup>
</Project>

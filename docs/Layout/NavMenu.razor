@inject SiteInfo Site
@inject ContentCollection<Article> Articles

<p class="nav-title">@KijiVersion</p>
<ul>
    @foreach (var doc in Articles.OrderBy(doc => doc.Order))
    {
        <li>
            <a href="@(Site.ResolveUrl($"docs/{doc.Slug}/").AbsolutePath)">
                @doc.Title
            </a>
        </li>
    }
</ul>

@code {
    private static readonly string KijiVersion = GetKijiVersion();

    private static string GetKijiVersion()
    {
        var informationalVersion = System.Reflection.CustomAttributeExtensions
            .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(SiteInfo).Assembly)
            ?.InformationalVersion;

        return $"v{informationalVersion?.Split('+')[0] ?? "unknown"}";
    }
}

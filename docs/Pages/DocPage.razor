@page "/docs/{Slug}/"
@inject ContentDictionary<Doc> Docs

@if (_doc is not null)
{
    <PageHead Title="@(_doc.Title ?? string.Empty)"
              Description="@(_doc.Description ?? string.Empty)" />

    <article class="doc">
        <h1>@_doc.Title</h1>
        <div class="doc-content">@((MarkupString)_html)</div>
    </article>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public string ContentKey { get; set; } = string.Empty;

    private Doc? _doc;
    private string _html = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _doc = Docs[ContentKey];
        _html = await _doc.RenderAsync();
    }
}

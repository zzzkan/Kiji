@inject NavigationManager NavigationManager
@inject SiteInfo Site

<HeadContent>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@PageTitle</title>
    <meta name="description" content="@Description" />
    <link rel="canonical" href="@NavigationManager.Uri" />
    <meta property="og:title" content="@PageTitle" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@NavigationManager.Uri" />
    <meta property="og:type" content="website" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/prismjs@@1.30.0/themes/prism-tomorrow.min.css" />
    <link rel="stylesheet" href="@($"{Site.BaseUrl.AbsolutePath}css/app.css")" />
    <script src="https://cdn.jsdelivr.net/npm/prismjs@@1.30.0/prism.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@@1.30.0/plugins/autoloader/prism-autoloader.min.js" defer></script>
    <link rel="icon"
          href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Ctext y='0.9em' font-size='96'%3E%F0%9F%93%B0%3C/text%3E%3C/svg%3E"
          type="image/svg+xml" />
</HeadContent>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;

    private string PageTitle =>
        string.IsNullOrWhiteSpace(Title) ? Site.Name : $"{Title} - {Site.Name}";
}

@page "/"
@inject SiteInfo Site
@inject ContentDictionary<Post> Posts

<PageHead Title="" Description="@Site.Description" />

<h1>@Site.Name</h1>
<p>@Site.Description</p>

<ul>
    @foreach (var post in Posts.Values.OrderByDescending(post => post.CreatedAt))
    {
        <li>
            <a href="@Site.Path($"{post.Slug}/")">@post.Title</a>
        </li>
    }
</ul>

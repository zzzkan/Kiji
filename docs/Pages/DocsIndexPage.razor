@page "/docs/"
@inject SiteInfo Site
@inject ContentDictionary<Doc> Docs

<PageHead Title="Documentation" Description="Guides for building a site with Kiji." />

<h1>Documentation</h1>

<ul class="doc-list">
    @foreach (var doc in Docs.Values.OrderBy(doc => doc.Order))
    {
        <li>
            <a href="@(Site.BaseUrl.AbsolutePath + $"docs/{doc.Slug}/")">
                @doc.Title
            </a>
            <p>@doc.Description</p>
        </li>
    }
</ul>

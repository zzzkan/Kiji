@page "/{Slug}/"
@inject ContentDictionary<Post> Posts

@if (_post is not null)
{
    <PageHead Title="@(_post.Title ?? string.Empty)"
              Description="@(_post.Description ?? string.Empty)" />

    <article>
        <h1>@_post.Title</h1>
        <div>@((MarkupString)_html)</div>
    </article>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    [Parameter] public string ContentKey { get; set; } = string.Empty;

    private Post? _post;
    private string _html = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _post = Posts[ContentKey];
        _html = await _post.RenderAsync();
    }
}

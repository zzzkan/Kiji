@inherits LayoutComponentBase
@inject SiteInfo Site

<StaticHeadContent>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/prismjs@@1.30.0/themes/prism-tomorrow.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/prismjs@@1.30.0/plugins/line-highlight/prism-line-highlight.min.css" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["Kiji.Docs.styles.css"]" />
    <script src="@Assets["js/prism.js"]" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@@1.30.0/prism.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@@1.30.0/plugins/autoloader/prism-autoloader.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@@1.30.0/plugins/line-highlight/prism-line-highlight.min.js" defer></script>
    <link rel="icon"
          href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Ctext y='0.9em' font-size='96'%3E%F0%9F%93%B0%3C/text%3E%3C/svg%3E"
          type="image/svg+xml" />
</StaticHeadContent>

<a class="skip-link" href="#main-content">Skip to content</a>

<header class="site-header">
    <input class="nav-toggle" type="checkbox" id="documentation-menu" aria-controls="mobile-documentation" />
    <div class="bar">
        <div class="brand">
            <label class="nav-toggle-label" for="documentation-menu">
                <span class="hamburger" aria-hidden="true"></span>
                <span class="visually-hidden">Toggle documentation menu</span>
            </label>
            <a class="site-title" href="@Site.BaseUrl.AbsolutePath">@($"📰 {Site.Name}")</a>
        </div>
        <nav aria-label="Main">
            <a href="https://github.com/zzzkan/kiji">GitHub</a>
            <a href="https://www.nuget.org/packages/Kiji">NuGet</a>
        </nav>
    </div>

    <nav class="mobile-nav" id="mobile-documentation" aria-label="Documentation">
        <NavMenu />
    </nav>
</header>

<div class="shell">
    <nav class="side-nav" aria-label="Documentation">
        <NavMenu />
    </nav>

    <main id="main-content">@Body</main>
</div>

<footer class="site-footer">
    <p>
        © 2026 zzzkan, built with
        <a href="https://github.com/zzzkan/kiji/">Kiji</a>.
    </p>
</footer>

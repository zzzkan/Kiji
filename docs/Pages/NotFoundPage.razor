@* Rendered to 404.html by app.UseNotFoundPage<NotFoundPage>(). A component is only a page
   if it declares a route, so this one has its own even though nothing links to it. *@
@page "/not-found/"
@inject SiteInfo Site

<PageHead Title="Not found" Description="This page does not exist." />

<h1>Not found</h1>
<p>
    That page does not exist. Try the <a href="@Site.Path("docs/")">documentation</a>
    or go <a href="@Site.Path("/")">home</a>.
</p>

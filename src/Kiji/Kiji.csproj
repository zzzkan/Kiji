<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Kiji</PackageId>
    <Description>Kiji is a static site generator framework for .NET. Pages are Razor components rendered to static HTML via HtmlRenderer and registered on a StaticSite. Includes a markdown content pipeline with YAML front matter, responsive WebP image optimization, RSS feed and sitemap artifacts, and a built-in on-demand dev server.</Description>
    <PackageTags>static-site-generator;ssg;razor;blazor;markdown</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hosting/livereload.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- build/, not buildTransitive/: these targets turn a project's publish output into a
         generated site, which is only ever right for a project that references Kiji directly.
         buildTransitive would also reach whatever references that project — a site's own test
         project first of all. The file name has to match the package id. -->
    <None Update="MSBuild/Kiji.targets" Pack="true" PackagePath="build/Kiji.targets" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Kiji.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Kiji.Benchmarks</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Kiji.SyntheticSite</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

@inject SiteInfo Site
@inject PageInfo Page
@inject ContentCollection<Article> Articles

@foreach (var section in Articles.OrderBy(doc => doc.Order).GroupBy(doc => doc.Section))
{
    <p class="section">@section.Key</p>
    <ul>
        @foreach (var doc in section)
        {
            var path = Site.ResolveUrl($"docs/{doc.Slug}/").AbsolutePath;
            <li>
                <a href="@path" aria-current="@(path == Page.Url.AbsolutePath ? "page" : null)">@doc.NavTitle</a>
            </li>
        }
    </ul>
}

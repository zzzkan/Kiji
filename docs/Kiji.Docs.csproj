<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Kiji.Docs</RootNamespace>
    <!-- The deployment host handles response compression; sidecars are unused. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Kiji/Kiji.csproj" />
  </ItemGroup>

  <Import Project="../src/Kiji/MSBuild/Kiji.targets" />

  <!-- This explicit import runs before the SDK computes its default PublishDir. -->
  <PropertyGroup Condition="'$(_KijiIsSiteApp)' == 'true' and '$(UseArtifactsOutput)' != 'true'">
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)/dist/</PublishDir>
  </PropertyGroup>

</Project>
